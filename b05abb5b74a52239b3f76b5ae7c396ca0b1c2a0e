      "writtenOn": "2024-03-15T21:34:38Z",
      "side": 1,
      "message": "Can you explain why they need to be saved and loaded in the same order? Are `VkImage`s not independent of each other?",
      "range": {
        "startLine": 451,
        "startChar": 8,
        "endLine": 451,
        "endChar": 72
      },
      "revId": "b05abb5b74a52239b3f76b5ae7c396ca0b1c2a0e",
