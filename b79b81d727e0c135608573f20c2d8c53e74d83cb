      "writtenOn": "2024-01-11T18:03:45Z",
      "side": 1,
      "message": "I don\u0027t think I understand the details and would need to look into it. Do you have some example code for stream_renderer_export_blob? Do they still keep the pointer to the memory region unchanged after cleanup/snapshot load with the fake guest?",
      "parentUuid": "7f2a535d_b8cfe6f8",
      "range": {
        "startLine": 3963,
        "startChar": 8,
        "endLine": 3996,
        "endChar": 42
