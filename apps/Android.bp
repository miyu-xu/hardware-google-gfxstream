package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "libgfxstream_vulkan_samples_jni",
    local_include_dirs: [
        "src/jni",
    ],
    srcs: [
        "src/jni/**/*.cpp",
    ],
    header_libs: [
        "vulkan_headers",
    ],
    shared_libs: [
        "libandroid",
        "libc++",
        "libjnigraphics",
        "liblog",
        "libnativehelper",
    ],
    whole_static_libs: [
        "android_native_app_glue",
    ],

    cflags: [
        "-DVK_USE_PLATFORM_ANDROID_KHR=1",
    ],
    min_sdk_version: "34",
    sdk_version: "current",
}

android_app {
    name: "GfxstreamVulkanSamplesApp",
    srcs: ["src/app/**/*.java"],
    min_sdk_version: "34",
    sdk_version: "current",
    jni_libs: ["libgfxstream_vulkan_samples_jni"],
    use_embedded_native_libs: true,
}
