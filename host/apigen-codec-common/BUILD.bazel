package(
    default_visibility = ["//:gfxstream_packages"],
)

cc_library(
    name = "apigen-codec-common",
    srcs = [
        "ChecksumCalculator.cpp",
        "ChecksumCalculator.h",
        "ChecksumCalculatorThreadInfo.cpp",
        "ChecksumCalculatorThreadInfo.h",
        "glUtils.cpp",
        "glUtils.h",
    ] + select({
        "@platforms//os:linux": [
            "X11Support.cpp",
            "X11Support.h",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob([
        "GL/**/*.h",
        "X11/**/*.h",
    ]) + [
        "GLDecoderContextData.h",
        "ProtocolUtils.h",
        "gl_base_types.h",
    ],
    copts = ["-fno-exceptions"],
    defines = [
        "EMUGL_BUILD",
        "BUILDING_EMUGL_COMMON_SHARED",
    ],
    includes = ["."],
    deps = [
        "@aemu//base:aemu-base-headers",
        "@aemu//host-common:aemu-host-common",
    ],
)
